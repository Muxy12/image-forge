# Port the HTTP service binds to.
PORT=8080

# Log filter (tracing EnvFilter syntax).
RUST_LOG=imageforge_api=info,tower_http=info

# CORS allowlist (comma-separated origins). Defaults to http://localhost:3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000

