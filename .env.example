# Root environment for the local async stack (docker-compose).
# Copy to `.env` and adjust. Never commit real secrets.

# Postgres (source of truth)
DATABASE_URL=postgres://imageforge:imageforge@localhost:5432/imageforge

# Redis Streams (job queue)
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally, Cloudflare R2 in production (S3-compatible).
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_BUCKET=imageforge
R2_ACCESS_KEY_ID=imageforge
R2_SECRET_ACCESS_KEY=imageforge-dev-secret
R2_UPLOAD_PREFIX=uploads
R2_RESULT_PREFIX=results

# Retention (seconds) for uploaded inputs and conversion results.
UPLOAD_TTL_SECONDS=3600
RESULT_TTL_SECONDS=86400
